# Local dev uses SQLite. For production set a PostgreSQL URL and update
# prisma/schema.prisma datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me"

# Secret for the Google Sheets import API (header x-import-token)
IMPORT_TOKEN="change-me"

# Email delivery (Resend) — powers admin password-reset codes and 2FA.
# Without RESEND_API_KEY, 2FA is disabled and reset falls back to manual.
RESEND_API_KEY=""
# Sender address. With no verified domain, Resend only delivers to the
# account owner's email from this default test sender.
EMAIL_FROM="iEnglish <onboarding@resend.dev>"
